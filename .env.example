# Copy to .env for local development
PORT=5000
NODE_ENV=development
# Comma separated frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# Local dev: path to your Firebase service-account JSON (file git me commit nahi hoti)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Production (Render): poora service-account JSON dashboard ke Environment tab me secret ke roop me daalo
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Registration OTP email - option 1 (RECOMMENDED, free 300 emails/day): Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=StockFlow Pro

# Option 2 (free 200 emails/month): EmailJS REST API - server side
# EmailJS dashboard -> Account -> "Allow EmailJS API for non-browser applications" ON karo, phir Private Key copy karo
OTP_SECRET=change-this-to-a-long-random-string
EMAILJS_PRIVATE_KEY=
# Optional (defaults maujooda template ke hain):
# EMAILJS_SERVICE_ID=service_15yzwik
# EMAILJS_TEMPLATE_ID=template_b81ib1p
# EMAILJS_PUBLIC_KEY=
